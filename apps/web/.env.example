# All values stay server-only. Set the hosted backend URL and exact frontend origin.
MEMORY_API_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:3000
# Generate once, then keep the same value: changing it logs out every session.
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_PROVIDER=local
# Connect the SAME private Blob store to both Vercel projects for hosted direct uploads.
# STORAGE_PROVIDER=vercel_blob
# BLOB_READ_WRITE_TOKEN=private-store-token
