{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/memory_db/.venv/bin/python -m memory_platform.hooks event --client codex",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/memory_db/.venv/bin/python -m memory_platform.hooks event --client codex",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/memory_db/.venv/bin/python -m memory_platform.hooks event --client codex",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
